# Multi-AI Platform Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required for ChatGPT and classification)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (required for Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini API Key (required for Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# xAI API Key (optional, for Grok - can leave empty if no credits)
XAI_API_KEY=xai-your-xai-api-key-here

# Database URL (use Supabase, Neon, or local PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database

# Development vs Production
NODE_ENV=production