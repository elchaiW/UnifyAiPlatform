{
  "name": "luminadoc",
  "build": {
    "main": "app/page.tsx",
    "buildCommand": "npx next build",
    "installCommand": "npm install",
    "dev": "npx next dev"
  },
  "run": {
    "main": ".next/standalone/server.js",
    "command": "npx next start"
  },
  "env": {
    "NODE_ENV": "production"
  },
  "engines": {
    "node": "18.x"
  }
}