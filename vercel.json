{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/requests/history",
      "dest": "/api/requests"
    },
    {
      "src": "/api/analytics/stats",
      "dest": "/api/analytics"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/requests/history",
      "destination": "/api/requests"
    },
    {
      "source": "/api/analytics/stats", 
      "destination": "/api/analytics"
    }
  ]
}