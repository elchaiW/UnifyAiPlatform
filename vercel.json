{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.0.7",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/requests/history",
      "destination": "/api/requests"
    },
    {
      "source": "/api/analytics/stats", 
      "destination": "/api/analytics"
    },
    {
      "source": "/api/transcribe/(.*)",
      "destination": "/api/transcribe"
    }
  ]
}